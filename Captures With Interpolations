import serial
import threading
import time
import matplotlib.pyplot as plt
import matplotlib.patches as patches
from matplotlib.animation import FuncAnimation

# Set-Up

SERIAL_PORT = "/dev/tty.usbmodem1101"
BAUD_RATE = 115200

DARK_FLOOR = 352

# Visualization / calibration defaults
RED_GAIN = 1.0
GREEN_GAIN = 1.0
BLUE_GAIN = 1.0
DISPLAY_WHITE_POINT = 65535

running = True

sensor_data = {
    "red_raw": 0,
    "green_raw": 0,
    "blue_raw": 0,
    "red_corr": 0,
    "green_corr": 0,
    "blue_corr": 0,
}

# Store up to 4 captures
captures = [
    {"red_corr": 0, "green_corr": 0, "blue_corr": 0, "red_display": 0, "green_display": 0, "blue_display": 0},
    {"red_corr": 0, "green_corr": 0, "blue_corr": 0, "red_display": 0, "green_display": 0, "blue_display": 0},
    {"red_corr": 0, "green_corr": 0, "blue_corr": 0, "red_display": 0, "green_display": 0, "blue_display": 0},
    {"red_corr": 0, "green_corr": 0, "blue_corr": 0, "red_display": 0, "green_display": 0, "blue_display": 0},
]

capture_count = 0
data_ready = False

INTERP_STEPS = 5

# Sensor Calibration

def calibrate_rgb(raw_R, raw_G, raw_B):
    R = max(0, raw_R - DARK_FLOOR)
    G = max(0, raw_G - DARK_FLOOR)
    B = max(0, raw_B - DARK_FLOOR)

    # Channel balancing - currently neutral
    R = int(R * RED_GAIN)
    G = int(G * GREEN_GAIN)
    B = int(B * BLUE_GAIN)

    # Clamp to display white point
    R = min(R, DISPLAY_WHITE_POINT)
    G = min(G, DISPLAY_WHITE_POINT)
    B = min(B, DISPLAY_WHITE_POINT)

    return R, G, B


def scale_to_byte(value):
    return int((value / DISPLAY_WHITE_POINT) * 255)


def calculate_grayscale(r, g, b):
    return int(0.21 * r + 0.72 * g + 0.07 * b)


# Linear Interpolation

def lerp(start, end, t):
    return start + (end - start) * t


def interpolate_rgb(capture_a, capture_b, t):
    r = lerp(capture_a["red_display"], capture_b["red_display"], t)
    g = lerp(capture_a["green_display"], capture_b["green_display"], t)
    b = lerp(capture_a["blue_display"], capture_b["blue_display"], t)

    return int(r), int(g), int(b)


# Serial Reader - Only updates on button press

def read_serial_data():
    """
    Expected Pico print format (on button press):
    Captured R: 12345 G: 23456 B: 34567 Rcorr: 10000 Gcorr: 20000 Bcorr: 30000
    """

    global running, data_ready, capture_count

    try:
        ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1)
        time.sleep(2)
        print(f"Connected to Pico on {SERIAL_PORT}")

        while running:
            if ser.in_waiting > 0:
                line = ser.readline().decode("utf-8").strip()
                print(f"[DEBUG] Received: {repr(line)}")
                
                if "Captured" in line or "R:" in line:
                    # Parse the line - handle CapturedR: format (no space)
                    parts = line.split()
                    print(f"[DEBUG] Split parts: {parts}")
                    
                    try:
                        # Handle "CapturedR:" format by looking through all parts
                        r_idx = None
                        g_idx = None
                        b_idx = None
                        
                        for i, p in enumerate(parts):
                            if p == "R:" or p.endswith("R:"):
                                r_idx = i
                            elif p == "G:":
                                g_idx = i
                            elif p == "B:":
                                b_idx = i
                        
                        if r_idx is not None and g_idx is not None and b_idx is not None:
                            red_raw = int(parts[r_idx + 1].rstrip(","))
                            green_raw = int(parts[g_idx + 1].rstrip(","))
                            blue_raw = int(parts[b_idx + 1].rstrip(","))
                            
                            print(f"[DEBUG] Parsed RAW - R:{red_raw}, G:{green_raw}, B:{blue_raw}")
                            
                            # Try to parse corrected values if present
                            try:
                                rcorr_idx = next((i for i, p in enumerate(parts) if "Rcorr:" in p), None)
                                gcorr_idx = next((i for i, p in enumerate(parts) if "Gcorr:" in p), None)
                                bcorr_idx = next((i for i, p in enumerate(parts) if "Bcorr:" in p), None)
                                
                                if rcorr_idx is not None and gcorr_idx is not None and bcorr_idx is not None:
                                    red_corr = int(parts[rcorr_idx + 1].rstrip(","))
                                    green_corr = int(parts[gcorr_idx + 1].rstrip(","))
                                    blue_corr = int(parts[bcorr_idx + 1].rstrip(","))
                                    print(f"[DEBUG] Parsed CORR - R:{red_corr}, G:{green_corr}, B:{blue_corr}")
                                else:
                                    print("[DEBUG] Corrected values not found, calculating...")
                                    red_corr, green_corr, blue_corr = calibrate_rgb(red_raw, green_raw, blue_raw)
                            except Exception as e:
                                print(f"[DEBUG] Error parsing corrected values: {e}")
                                red_corr, green_corr, blue_corr = calibrate_rgb(red_raw, green_raw, blue_raw)
                            
                            # Store in captures list (up to 4)
                            if capture_count < 4:
                                red_display = scale_to_byte(red_corr)
                                green_display = scale_to_byte(green_corr)
                                blue_display = scale_to_byte(blue_corr)
                                
                                captures[capture_count] = {
                                    "red_corr": red_corr,
                                    "green_corr": green_corr,
                                    "blue_corr": blue_corr,
                                    "red_display": red_display,
                                    "green_display": green_display,
                                    "blue_display": blue_display,
                                }
                                
                                capture_count += 1
                                data_ready = True
                                print(f"Capture {capture_count}/4 stored! R:{red_raw} G:{green_raw} B:{blue_raw}")
                            else:
                                print("Maximum 4 captures reached!")
                        else:
                            print("[DEBUG] Could not find R:, G:, B: in parts")

                    except (ValueError, IndexError) as e:
                        print(f"[DEBUG] Parsing error: {e}")

    except serial.SerialException as e:
        print(f"Could not connect to {SERIAL_PORT}")
        print(e)

    finally:
        try:
            ser.close()
        except:
            pass


# Matplotlib Display - 4 Captures + 3 Interpolation Panels

fig, axes = plt.subplots(1, 7, figsize=(18, 4))
fig.suptitle("Rossi Pixel - Linear Interpolation v1", fontsize=14, weight="bold")

display_slots = [
    ("capture", 0),
    ("interp", 0, 1),
    ("capture", 1),
    ("interp", 1, 2),
    ("capture", 2),
    ("interp", 2, 3),
    ("capture", 3),
]


def draw_capture(ax, capture_index):
    capture = captures[capture_index]

    red_display = capture["red_display"]
    green_display = capture["green_display"]
    blue_display = capture["blue_display"]

    rgb_color = (
        red_display / 255,
        green_display / 255,
        blue_display / 255,
    )

    gray_value = calculate_grayscale(red_display, green_display, blue_display)

    ax.set_title(
        f"Capture {capture_index + 1}\nRGB({red_display}, {green_display}, {blue_display})\nGray: {gray_value}",
        fontsize=9,
        weight="bold"
    )

    rgb_square = patches.Rectangle(
        (0.1, 0.1),
        0.8,
        0.8,
        facecolor=rgb_color,
        edgecolor="black",
        linewidth=2,
    )
    ax.add_patch(rgb_square)


def draw_interpolation(ax, start_index, end_index):
    ax.set_title(
        f"Interpolation\n{start_index + 1} → {end_index + 1}",
        fontsize=9,
        weight="bold"
    )

    strip_width = 0.8 / INTERP_STEPS

    for step in range(INTERP_STEPS):
        t = step / (INTERP_STEPS - 1)

        r, g, b = interpolate_rgb(
            captures[start_index],
            captures[end_index],
            t
        )

        rgb_color = (
            r / 255,
            g / 255,
            b / 255,
        )

        x_position = 0.1 + (step * strip_width)

        interp_square = patches.Rectangle(
            (x_position, 0.1),
            strip_width,
            0.8,
            facecolor=rgb_color,
            edgecolor="black",
            linewidth=0.5,
        )
        ax.add_patch(interp_square)


def update_display(frame):
    global data_ready
    
    for idx, ax in enumerate(axes):
        ax.clear()
        ax.set_xlim(0, 1)
        ax.set_ylim(0, 1)
        ax.axis("off")

        slot = display_slots[idx]

        if slot[0] == "capture":
            capture_index = slot[1]

            if capture_index < capture_count:
                draw_capture(ax, capture_index)
            else:
                ax.set_title(
                    f"Capture {capture_index + 1}\n(empty)",
                    fontsize=9,
                    style="italic",
                    color="gray"
                )

        elif slot[0] == "interp":
            start_index = slot[1]
            end_index = slot[2]

            if end_index < capture_count:
                draw_interpolation(ax, start_index, end_index)
            else:
                ax.set_title(
                    f"Interpolation\n{start_index + 1} → {end_index + 1}\n(waiting)",
                    fontsize=9,
                    style="italic",
                    color="gray"
                )

    data_ready = False


# MAIN

if __name__ == "__main__":
    serial_thread = threading.Thread(target=read_serial_data, daemon=True)
    serial_thread.start()

    ani = FuncAnimation(fig, update_display, interval=100, blit=False, cache_frame_data=False)

    try:
        plt.show()
    except KeyboardInterrupt:
        print("\nProgram stopped")
    finally:
        running = False
