# TOOLS

import threading
import time

import matplotlib.pyplot as plt
import serial
from matplotlib.animation import FuncAnimation
from matplotlib.patches import Rectangle

#SERIAL SETTINGS: PICO CONNECTION, BAUD RATE (COMMS) AND ADC RANGE
SERIAL_PORT = "/dev/tty.usbmodem1101"
BAUD_RATE = 115200
ADC_MAX = 65_535

#SENSOR DATA: STORE LATEST RAW AND CORRECTED RGB VALUES
sensor_data = {
    "raw": (0, 0, 0),
    "corrected": (0, 0, 0),
}

# FUNCTION: CONVERT 16-BIT ADC VALUE TO 8-BIT DISPLAY VALUE
def scale_to_byte(value):
    return round(value / ADC_MAX * 255)

# FUNCTION: CALCULATE GRAYSCALE FROM 8-BIT RGB VALUES
def calculate_grayscale(red, green, blue):
    return round(0.30 * red + 0.59 * green + 0.11 * blue)

# FUNCTION: PARSE RAW AND CORRECTED RGB VALYES FROM PICO SERIAL OUTPUT
def parse_sensor_data(line):

    # SERIAL INPUT: SPLIT TEXT INTO INDIVIDUAL VALUES
    parts = line.split()

    try:

        # RAW RGB: FIND VALUES AFTER R, G, B LABELS
        raw = (
            int(parts[parts.index("R:") + 1]),
            int(parts[parts.index("G:") + 1]),
            int(parts[parts.index("B:") + 1]),
        )

        # CORRECTED RGB: FIND VALUES AFTER CORRECTED CHANNEL LABELS
        corrected = (
            int(parts[parts.index("Rcorr:") + 1]),
            int(parts[parts.index("Gcorr:") + 1]),
            int(parts[parts.index("Bcorr:") + 1]),
        )

        return raw, corrected

# INVALID SERIAL LINE: IGNORE LINES WITHOUT EXPECTED VALUES
    except (ValueError, IndexError):
        return None

# FUNCTION: READ SENSOR DATA FROM PICO OVER SERIAL
def read_serial_data():
    try:
        # SERIAL CONNECTION: OPEN USB PORT TO PICO
        with serial.Serial(
            SERIAL_PORT,
            BAUD_RATE,
            timeout=1,
        ) as pico:
            
        # CONECTION DELAY: ALLOW PICO SERIAL CONNECTION TO INITIALIZE
            time.sleep(2)

            print(f"Connected to Pico on {SERIAL_PORT}")
            print("Press the Pico button to capture a pixel.\n")

            # SERIAL LOOOP CONTINUOUSLY WAITS FOR NEW DATA
            while True:

                # SERIAL INPOUT: READ AND DECODE ONE LINE FROM PICO
                line = pico.readline().decode(
                    "utf-8",
                    errors="ignore",
                ).strip()

                # PARSE DATA: EXTRACT RAW AND CORRECTED RGB VALUES
                parsed = parse_sensor_data(line)

                # SENSOR UPDATE: STORE MOST RECENT VALID PIXEL
                if parsed is not None:
                    sensor_data["raw"], sensor_data["corrected"] = parsed
                    print(f"Received: {line}")

# SERIAL ERROR: REPORT FAILED PICO CONNECTION 
    except serial.SerialException as error:
        print(f"Could not connect to {SERIAL_PORT}: {error}")
        
# DISPLAY SETUP: CREATE VALUE, RGB, AND GRAYSCALE PANELS

fig, (ax_text, ax_rgb, ax_gray) = plt.subplots(
    1,
    3,
    figsize=(12, 4),
)

fig.suptitle("Pixel", fontsize=14, weight="bold")

# AXES SETUP: PREPARE ALL THREE DISPLAU PANELS
for axis in (ax_text, ax_rgb, ax_gray):
    axis.set_xlim(0, 1)
    axis.set_ylim(0, 1)
    axis.axis("off")

# PANEL TITLES
ax_text.set_title("Values", fontsize=12, weight="bold")
ax_rgb.set_title("Mixed RGB Pixel", fontsize=12, weight="bold")
ax_gray.set_title("Grayscale Pixel", fontsize=12, weight="bold")

# TEXT DISPLAY: CREATE PLAEHOLDER FOR SENSOR VALUES
value_text = ax_text.text(
    0.05,
    0.95,
    "",
    va="top",
    family="monospace",
    fontsize=11,
    transform=ax_text.transAxes,
)

# RGB PIXEL: CREATE COLOR PATCH ONCE
rgb_patch = Rectangle(
    (0.1, 0.1),
    0.8,
    0.8,
    facecolor="black",
    edgecolor="black",
    linewidth=2,
)


# GRAYSCALE PIXEL: CREATE GRAY PATCH ONCE
gray_patch = Rectangle(
    (0.1, 0.1),
    0.8,
    0.8,
    facecolor="black",
    edgecolor="black",
    linewidth=2,
)

# DISPLAY: ADD PIXEL PATCHES TO THEIR PANELS
ax_rgb.add_patch(rgb_patch)
ax_gray.add_patch(gray_patch)


# FUNCTION: UPDATE DISPLAY USING LATEST SENSOR VALUES
def update_display(_):
    
 # SENSOR INPUT: GET RAW AND CORRECTED 16-BIT RGB VALUES
    raw = sensor_data["raw"]
    corrected = sensor_data["corrected"]
    
# DISPLAY CONVERSION: SCALE CORRECTED 16-BIT RGB TO 8-BIT RGB
    display = tuple(
        scale_to_byte(value)
        for value in corrected
    )
    
# GRAYSCALE: CALCULATE 8-BIT GRAY VALUE FROM DISPLAY RGB
    gray_value = calculate_grayscale(*display)
    
# TEXT OUTPUT: SHOW RAW, CORRECTED, DISPLAY, AND GRAY VALUES
    value_text.set_text(
        "RAW VALUES\n"
        f"R: {raw[0]:5d}\n"
        f"G: {raw[1]:5d}\n"
        f"B: {raw[2]:5d}\n\n"
        "CORRECTED VALUES\n"
        f"R: {corrected[0]:5d}\n"
        f"G: {corrected[1]:5d}\n"
        f"B: {corrected[2]:5d}\n\n"
        "DISPLAY VALUES\n"
        f"R: {display[0]:3d}\n"
        f"G: {display[1]:3d}\n"
        f"B: {display[2]:3d}\n\n"
        f"Gray: {gray_value:3d}"
    )

# RGB DISPLAY: NORMALIZE 8-BIT RGB TO 0-1 FOR MATPLOTLIB
    rgb_patch.set_facecolor(
        tuple(value / 255 for value in display)
    )

# GRAYSCALE DISPLAY: NORMALIZE GRAY TO 0-1 FOR MATPLOTLIB
    gray_patch.set_facecolor(
        (gray_value / 255,) * 3
    )

# OUTPUT: START SERIAL READER AND LIVE PIXEL DISPLAY
if __name__ == "__main__":
    print("Starting Rossi Live Pixel Visualizer")
    print(f"Serial port: {SERIAL_PORT}")

# THREAD: READ SERIAL DATA WITHOUT BLOCKING DISPLAY
    threading.Thread(
        target=read_serial_data,
        daemon=True,
    ).start()

# ANIMATION: REFRESH DISPLAY USING LATEST SENSOR DATA
    animation = FuncAnimation(
        fig,
        update_display,
        interval=100,
        cache_frame_data=False,
    )

# DISPLAY OUTPUT: SHOW LIVE PIXEL
    plt.show()
