#Tools 

import serial
import threading
import time
import matplotlib.pyplot as plt
import matplotlib.patches as patches
from matplotlib.animation import FuncAnimation

#Set-Up

# macOS serial port usually includes a dot after tty
SERIAL_PORT = "/dev/tty.usbmodem1101" 
BAUD_RATE = 115200

DARK_FLOOR = 352

running = True

sensor_data = {
    "red_raw": 0,
    "green_raw": 0,
    "blue_raw": 0,
}


# Sensor Calibration

def calibrate_rgb(raw_R, raw_G, raw_B):
    R = max(0, raw_R - DARK_FLOOR)
    G = max(0, raw_G - DARK_FLOOR)
    B = max(0, raw_B - DARK_FLOOR)

    # Clamp to white ceiling of 50000
    R = min(R, 50000)
    G = min(G, 50000)
    B = min(B, 50000)

    return R, G, B


def scale_to_byte(value):
    # Scale from 0-50000 to 0-255
    return int((value / 50000) * 255)


def calculate_grayscale(r, g, b):
    return int(0.30 * r + 0.59 * g + 0.11 * b)


# Serial Reader

def read_serial_data():
    """
    Expected Pico print format:

    R: 12345 G: 23456 B: 34567 B boosted: 40000
    """

    global running

    try:
        ser = serial.Serial(SERIAL_PORT, BAUD_RATE, timeout=1)
        time.sleep(2)
        print(f"Connected to Pico on {SERIAL_PORT}")

        while running:
            if ser.in_waiting > 0:
                line = ser.readline().decode("utf-8").strip()
                parts = line.split()

                try:
                    if "R:" in parts and "G:" in parts and "B:" in parts:
                        sensor_data["red_raw"] = int(parts[parts.index("R:") + 1])
                        sensor_data["green_raw"] = int(parts[parts.index("G:") + 1])
                        sensor_data["blue_raw"] = int(parts[parts.index("B:") + 1])

                except ValueError:
                    pass
                except IndexError:
                    pass

    except serial.SerialException as e:
        print(f"Could not connect to {SERIAL_PORT}")
        print(e)

    finally:
        try:
            ser.close()
        except:
            pass


# Matplotlib Display

fig, (ax_text, ax_rgb, ax_gray) = plt.subplots(1, 3, figsize=(12, 4))

fig.suptitle("Rossi Pixel", fontsize=14, weight="bold")


def update_display(frame):
    red_raw = sensor_data["red_raw"]
    green_raw = sensor_data["green_raw"]
    blue_raw = sensor_data["blue_raw"]

    red_corr, green_corr, blue_corr = calibrate_rgb(red_raw, green_raw, blue_raw)

    red_display = scale_to_byte(red_corr)
    green_display = scale_to_byte(green_corr)
    blue_display = scale_to_byte(blue_corr)

    gray_value = calculate_grayscale(red_display, green_display, blue_display)

    rgb_color = (
        red_display / 255,
        green_display / 255,
        blue_display / 255,
    )

    gray_color = (
        gray_value / 255,
        gray_value / 255,
        gray_value / 255,
    )

    # Clear only these simple display areas
    ax_text.clear()
    ax_rgb.clear()
    ax_gray.clear()

   #Text Display

    ax_text.axis("off")
    ax_text.set_title("Values", fontsize=12, weight="bold")

    text = (
        f"RAW VALUES\n"
        f"R raw:      {red_raw:5d}\n"
        f"G raw:      {green_raw:5d}\n"
        f"B raw:      {blue_raw:5d}\n\n"
        f"CORRECTED VALUES\n"
        f"R corr:     {red_corr:5d}\n"
        f"G corr:     {green_corr:5d}\n"
        f"B corr:     {blue_corr:5d}\n\n"
        f"DISPLAY VALUES\n"
        f"R display:  {red_display:3d}\n"
        f"G display:  {green_display:3d}\n"
        f"B display:  {blue_display:3d}\n\n"
        f"GRAY VALUE\n"
        f"Gray:       {gray_value:3d}"
    )

    ax_text.text(
        0.05,
        0.95,
        text,
        va="top",
        family="monospace",
        fontsize=11,
        transform=ax_text.transAxes,
    )

  # COLOR PIXEL

    ax_rgb.set_xlim(0, 1)
    ax_rgb.set_ylim(0, 1)
    ax_rgb.axis("off")
    ax_rgb.set_title("Mixed RGB Pixel", fontsize=12, weight="bold")

    rgb_square = patches.Rectangle(
        (0.1, 0.1),
        0.8,
        0.8,
        facecolor=rgb_color,
        edgecolor="black",
        linewidth=2,
    )

    ax_rgb.add_patch(rgb_square)

 # GRAY PIXEL

    ax_gray.set_xlim(0, 1)
    ax_gray.set_ylim(0, 1)
    ax_gray.axis("off")
    ax_gray.set_title("Grayscale Pixel", fontsize=12, weight="bold")

    gray_square = patches.Rectangle(
        (0.1, 0.1),
        0.8,
        0.8,
        facecolor=gray_color,
        edgecolor="black",
        linewidth=2,
    )

    ax_gray.add_patch(gray_square)


# MAIN

if __name__ == "__main__":
    print("Starting Pico RGB Sensor Visualizer")
    print(f"Serial port: {SERIAL_PORT}")
    print("Press Ctrl+C to stop\n")

    serial_thread = threading.Thread(target=read_serial_data, daemon=True)
    serial_thread.start()

    ani = FuncAnimation(fig, update_display, interval=100, blit=False)

    try:
        plt.show()
    except KeyboardInterrupt:
        print("\nProgram stopped")
    finally:
        running = False
